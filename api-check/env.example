# Copy to .env and fill in.

# --- Auth (pick one) ---
SRM_NETID=user@srmist.edu.in
SRM_PASSWORD=

# Full Cookie header from browser DevTools (works when password API breaks)
# SRM_COOKIE=

# Optional exact timetable / profile page URL from your browser
# SRM_PROFILE_PAGE=
# SRM_TIMETABLE_PAGE=

# Debug: log which portal URL worked
# SRM_DEBUG=1

# --- If scraping always fails: bootstrap profile so the app still opens ---
# Use your real registration number and name (from ID card / portal).
SRM_BOOTSTRAP_REG=RA2311000000000
SRM_BOOTSTRAP_NAME=Your Full Name
# SRM_BOOTSTRAP_DEPARTMENT=CSE
# SRM_BOOTSTRAP_SECTION=A
# SRM_BOOTSTRAP_EMAIL=user@srmist.edu.in
